# Mash'al Fund Manager — copy to .env for local dev (never commit a real .env).
# On Vercel, set these in Project -> Settings -> Environment Variables instead.
# DATABASE_URL: Supabase Postgres connection string — use the SESSION POOLER
# URI from Supabase (Project Settings -> Database -> Connection string, port 6543),
# with ?sslmode=require at the end. Example shape (DO NOT use this value):
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
